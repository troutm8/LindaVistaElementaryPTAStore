# All optional. With nothing set, the store runs in demo mode:
# PGlite file database, fake "payment", emails printed to the console, admin open.

# Postgres connection string (Neon / Vercel Postgres). Unset = PGlite in .data/pglite.
DATABASE_URL=

# Square. Both unset = demo checkout (no card, order is marked paid immediately).
# Sandbox credentials come from https://developer.squareup.com/apps → your app → Credentials.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox          # or production
# From the app's Webhooks tab after subscribing to payment.created / payment.updated.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Only if the registered notification URL differs from NEXT_PUBLIC_BASE_URL + /api/square/webhook.
SQUARE_WEBHOOK_URL=

# Resend. Unset = emails are logged to the server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Linda Vista PTA Store <store@example.org>"
# Volunteers who get an email for every new paid order (comma-separated). Unset = none.
NOTIFY_EMAIL=

# Protects /admin with HTTP basic auth (any username). Required in production.
ADMIN_PASSWORD=

# Public base URL, used for links in emails and Square redirects.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
